--- !u!114 &2793364045146657364
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9179650952479221963}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f326c449df3b9604e80aac24b70c588e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossRaid.UI.HunterBookPanel
  player: {fileID: 0}
  pages:
  - id: Controls
    title: "\uC870\uC791"
    unlock: 0
    body: "\uC774\uB3D9  WASD\n\uB2EC\uB9AC\uAE30  Left Shift (\uB204\uB974\uACE0
      \uC788\uB294 \uB3D9\uC548, \uC2A4\uD0DC\uBBF8\uB098\uB97C \uC500)\n\uCE74\uBA54\uB77C 
      \uB9C8\uC6B0\uC2A4\n\n<color=#F9C775>\uACF5\uACA9  \uC88C\uD074\uB9AD</color>\n\uB204\uB974\uBA74
      \uCE7C\uC744 \uB4E4\uACE0, \uB204\uB974\uACE0 \uC788\uC73C\uBA74 \uD798\uC744
      \uBAA8\uC73C\uACE0(\uCC28\uC9C0), \uB5BC\uBA74 \uB0B4\uB824\uCE69\uB2C8\uB2E4.\n\uC624\uB798
      \uBAA8\uC744\uC218\uB85D \uAC15\uD558\uAC8C \uB4E4\uC5B4\uAC11\uB2C8\uB2E4.
      \uBAB8\uC744 \uAC10\uC2F8\uB294 \uBE5B\uC758 \uC0C9\uC73C\uB85C \uCC28\uC9C0
      \uB2E8\uACC4\uB97C \uC54C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uC5B4\uC11C
      \uB204\uB974\uBA74 3\uD0C0\uAE4C\uC9C0 \uC774\uC5B4\uC9D1\uB2C8\uB2E4.\n\n<color=#F9C775>\uAD6C\uB974\uAE30 
      Space</color>\n\uAD6C\uB974\uB294 \uC21C\uAC04\uC5D0\uB294 \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uD070 \uACF5\uACA9, \uAC00\uB4DC\uD560 \uC218 \uC5C6\uB294 \uACF5\uACA9\uC740
      \uAD74\uB7EC\uC11C \uD53C\uD558\uC138\uC694.\n\n<color=#F9C775>\uAC00\uB4DC 
      Left Ctrl</color> (\uB204\uB974\uACE0 \uC788\uB294 \uB3D9\uC548)\n\uC55E\uC5D0\uC11C
      \uC624\uB294 \uACF5\uACA9\uB9CC \uB9C9\uC2B5\uB2C8\uB2E4. \uB9C9\uC73C\uBA74
      \uBC00\uB824\uB098\uACE0 \uC2A4\uD0DC\uBBF8\uB098\uAC00 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.\n\uB9DE\uAE30
      \uC9C1\uC804\uC5D0 \uB204\uB974\uBA74 <color=#F9C775>\uD37C\uD399\uD2B8 \uAC00\uB4DC</color>:
      \uBC00\uB9AC\uC9C0 \uC54A\uACE0, \uBCF4\uC2A4\uAC00 \uC9C0\uCE58\uACE0, \uB2E4\uC74C
      \uACF5\uACA9\uC758 \uCC28\uC9C0\uAC00 \uD55C \uB2E8\uACC4 \uC55E\uC11C \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uAC00\uB4DC\uD560
      \uC218 \uC5C6\uB294 \uACF5\uACA9\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\n\n<color=#F9C775>\uD68C\uBCF5\uC57D 
      R</color>\n\uB9C8\uC6B0\uC2A4 \uD720\uB85C \uD68C\uBCF5\uC57D\uACFC \uC778\uAC04\uC131
      \uC911 \uC4F8 \uAC83\uC744 \uACE0\uB985\uB2C8\uB2E4."
  - id: Death
    title: "\uC8FD\uC74C\uACFC \uC18C\uC6B8"
    unlock: 0
    body: "\uBCF4\uC2A4\uC5D0\uAC8C \uC900 \uD53C\uD574\uB9CC\uD07C \uC18C\uC6B8\uC744
      \uBC1B\uC2B5\uB2C8\uB2E4. \uC4F0\uB7EC\uB728\uB9AC\uC9C0 \uBABB\uD558\uACE0
      \uC8FD\uC5B4\uB3C4 \uBC1B\uC2B5\uB2C8\uB2E4.\n\uC4F0\uB7EC\uB728\uB9AC\uBA74
      \uC18C\uC6B8\uC744 \uAC00\uC7A5 \uB9CE\uC774 \uBC1B\uC2B5\uB2C8\uB2E4.\n\n\uB300\uC2E0
      \uC8FD\uC73C\uBA74 \uADF8\uB54C <color=#F9C775>\uB4E4\uACE0 \uC788\uB358 \uC18C\uC6B8\uC740
      \uD22C\uAE30\uC7A5\uC5D0 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4.</color>\n\uB2E4\uC74C\uC5D0
      \uAC19\uC740 \uB2E8\uACC4\uC758 \uD22C\uAE30\uC7A5\uC5D0 \uB4E4\uC5B4\uAC00
      \uADF8 \uC790\uB9AC\uC5D0 \uAC00\uBA74 \uB2E4\uC2DC \uC8FC\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC90D\uC9C0
      \uBABB\uD558\uACE0 \uB610 \uC8FD\uC73C\uBA74 \uC808\uBC18\uB9CC \uD654\uD1B3\uBD88\uB85C
      \uB3CC\uC544\uC624\uACE0 \uB098\uBA38\uC9C0\uB294 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n\n\uC18C\uC6B8\uC740
      \uC7A5\uBE44\uB97C \uB9CC\uB4E4\uACE0 \uAC15\uD654\uD558\uACE0, \uC694\uB9AC\uB97C
      \uD558\uB294 \uB370 \uC501\uB2C8\uB2E4.\n\uBAA8\uC544 \uB454 \uC18C\uC6B8\uC774
      \uB9CE\uC744\uC218\uB85D \uC783\uC744 \uAC83\uB3C4 \uB9CE\uC2B5\uB2C8\uB2E4."
  - id: Parts
    title: "\uBD80\uC704\uD30C\uAD34\uC640 \uC18C\uC7AC"
    unlock: 1
    body: "\uC6A9\uC758 <color=#F9C775>\uBA38\uB9AC(\uBFD4), \uAF2C\uB9AC, \uC591
      \uC55E\uBC1C</color>\uC740 \uB530\uB85C \uAE68\uC9D1\uB2C8\uB2E4. \uD55C \uBD80\uC704\uB97C
      \uACC4\uC18D \uB54C\uB9AC\uBA74 \uAE68\uC9D1\uB2C8\uB2E4.\n\uAE68\uC9C0\uB294
      \uC21C\uAC04 \uBAB8\uC774 \uBC88\uCA4D\uC774\uACE0 \uAE08\uC774 \uAC04 \uC790\uAD6D\uC774
      \uB0A8\uC2B5\uB2C8\uB2E4. \uAF2C\uB9AC\uB294 \uC798\uB824 \uB098\uAC11\uB2C8\uB2E4.\n\uAE68\uC9C4
      \uBD80\uC704\uB294 \uB354 \uC544\uD504\uAC8C \uB4E4\uC5B4\uAC11\uB2C8\uB2E4.\n\n\uBD80\uC704\uAC00
      \uAE68\uC9C0\uBA74 \uADF8 \uBD80\uC704\uC758 \uC18C\uC7AC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\n\uBFD4
      \u2192 \uBFD4 / \uAF2C\uB9AC \u2192 \uAF2C\uB9AC \uACE0\uAE30, \uAF2C\uB9AC
      \uAC00\uC2DC / \uC55E\uBC1C \u2192 \uD654\uB8E1 \uBE44\uB298\n\uBCF4\uC2A4\uC758
      \uCCB4\uB825\uC744 \uB9CE\uC774 \uAE4E\uC544\uB3C4 \uD654\uB8E1 \uBE44\uB298\uC774
      \uB098\uC635\uB2C8\uB2E4.\n\n<color=#F9C775>\uC774\uBC88 \uD310\uC5D0 \uC5BB\uC740
      \uC18C\uC7AC\uB294 \uC8FD\uC5B4\uB3C4 \uBC1B\uC2B5\uB2C8\uB2E4.</color>\n\uB9CC\uB4E4\uACE0
      \uC2F6\uC740 \uC7A5\uBE44\uC5D0 \uD544\uC694\uD55C \uBD80\uC704\uB97C \uB178\uB9AC\uC138\uC694."
  - id: Forge
    title: "\uB300\uC7A5\uAC04"
    unlock: 1
    body: "\uB9C8\uC744\uC758 \uB300\uC7A5\uAC04\uC5D0\uC11C [E]\uB85C \uBB34\uAE30\uC640
      \uBC29\uC5B4\uAD6C\uB97C \uB9CC\uB4E4\uACE0 \uAC15\uD654\uD569\uB2C8\uB2E4.
      \uC18C\uC6B8\uACFC \uBCF4\uC2A4 \uC18C\uC7AC\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.\n\n<color=#F9C775>\uBB34\uAE30</color>\n\uCCA0
      \uB300\uAC80: \uAC00\uB4DC \uC0AC\uC6A9\uC2DC \uC2A4\uD0DC\uBBF8\uB098\uAC00
      \uB35C \uB4ED\uB2C8\uB2E4.\n\uAF2C\uB9AC\uBF08 \uB300\uAC80: \uACF5\uACA9\uB825\uC774
      \uAC00\uC7A5 \uB192\uC2B5\uB2C8\uB2E4.\n\uC6A9\uBFD4 \uB300\uAC80: \uAE68\uC9C4
      \uBD80\uC704\uC5D0 \uB354 \uC544\uD504\uAC8C \uB4E4\uC5B4\uAC11\uB2C8\uB2E4.\n\n<color=#F9C775>\uBC29\uC5B4\uAD6C</color>\n\uBC1B\uB294
      \uD53C\uD574\uB97C \uC904\uC785\uB2C8\uB2E4. \uD654\uB8E1 \uBE44\uB298 \uC138\uD2B8\uB294
      \uBD88 \uD53C\uD574\uC640 \uAC00\uB4DC \uC2A4\uD0DC\uBBF8\uB098\uB3C4 \uC904\uC5EC
      \uC90D\uB2C8\uB2E4.\n\n\uB9CC\uB4E0 \uC7A5\uBE44\uB294 \uBAA8\uB450 \uAC00\uC9C0\uACE0
      \uC788\uACE0, \uB300\uC7A5\uAC04\uC5D0\uC11C \uACE8\uB77C \uB084 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: Humanity
    title: "\uC778\uAC04\uC131\uACFC \uD654\uD1B3\uBD88"
    unlock: 2
    body: "\uC778\uAC04\uC131\uC740 \uBCF4\uC2A4\uB97C \uCC98\uC74C \uC4F0\uB7EC\uB728\uB9AC\uBA74
      \uC5BB\uC2B5\uB2C8\uB2E4. \uBD80\uC704\uB97C \uAE68\uAC70\uB098 \uB2E4\uC2DC
      \uC4F0\uB7EC\uB728\uB9B4 \uB54C\uB3C4 \uAC00\uB054 \uC5BB\uC2B5\uB2C8\uB2E4.\n\n<color=#F9C775>\uD0DC\uC6B0\uAE30</color> 
      \uD654\uD1B3\uBD88\uC5D0\uC11C [E]\n\uD68C\uBCF5\uC57D\uC758 \uCD5C\uB300 \uAC1C\uC218\uAC00
      \uD558\uB098 \uB298\uC5B4\uB0A9\uB2C8\uB2E4. \uC601\uC6D0\uD788 \uB0A8\uC2B5\uB2C8\uB2E4.\n\n<color=#F9C775>\uC0AC\uC6A9</color> 
      \uB9C8\uC6B0\uC2A4 \uD720\uB85C \uC778\uAC04\uC131\uC744 \uACE0\uB974\uACE0
      R\n\uCCB4\uB825\uC744 \uC804\uBD80 \uD68C\uBCF5\uD558\uACE0 \uC0AC\uB78C \uC0C1\uD0DC\uAC00
      \uB418\uC5B4 \uCD5C\uB300 \uCCB4\uB825\uC774 \uB298\uC5B4\uB0A9\uB2C8\uB2E4.\n\uC0AC\uB78C
      \uC0C1\uD0DC\uB294 \uC8FD\uC73C\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n\n\uC9C0\uAE08
      \uAC15\uD574\uC9C8\uC9C0, \uD68C\uBCF5\uC57D\uC744 \uC601\uC6D0\uD788 \uB298\uB9B4\uC9C0
      \uACE0\uB974\uC138\uC694."
  - id: Cooking
    title: "\uC694\uB9AC"
    unlock: 2
    body: "\uD654\uD1B3\uBD88 \uC606 \uB0C4\uBE44\uC5D0\uC11C [E]\uB85C \uC694\uB9AC\uD569\uB2C8\uB2E4.\n\n\uD1A0
      \uC804\uC5D0 <color=#F9C775>\uD55C \uB07C</color>\uB9CC \uBA39\uC744 \uC218
      \uC788\uACE0, \uBA39\uC790\uB9C8\uC790 \uD6A8\uACFC\uAC00 \uC0DD\uAE41\uB2C8\uB2E4.\n\uC0AC\uB0E5\uC774
      \uB05D\uB098\uBA74(\uC4F0\uB7EC\uB728\uB9AC\uB4E0 \uC8FD\uB4E0) \uD6A8\uACFC\uB294
      \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n\uB2E4\uB978 \uC694\uB9AC\uB85C \uBC14\uAFC0
      \uC218 \uC788\uC9C0\uB9CC \uBA39\uB358 \uD6A8\uACFC\uB294 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n\n\uAF2C\uB9AC
      \uACE0\uAE30, \uD654\uB8E1 \uC2EC\uC7A5\uC744 \uCC98\uC74C \uC5BB\uC73C\uBA74
      \uC0C8 \uC694\uB9AC\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4.\n\uBD88\uC774 \uBB34\uC12D\uB2E4\uBA74
      \uD654\uB8E1 \uC2EC\uC7A5 \uCC1C\uC744 \uCC3E\uC544\uBCF4\uC138\uC694."
  - id: Stage2
    title: "2\uB2E8\uACC4: \uBD89\uC740 \uC6A9"
    unlock: 2
    body: "\uB9C8\uC744\uC758 \uB450 \uBC88\uC9F8 \uC548\uAC1C\uBB38\uC73C\uB85C
      2\uB2E8\uACC4\uC5D0 \uB3C4\uC804\uD569\uB2C8\uB2E4. \uB354 \uB2E8\uB2E8\uD558\uACE0
      \uB354 \uC544\uD504\uAC8C \uB54C\uB9BD\uB2C8\uB2E4.\n\n<color=#F9C775>\uBD88</color>\n\uBE0C\uB808\uC2A4\uB098
      \uBD88\uB369\uC774\uC5D0 \uB9DE\uC73C\uBA74 \uBAB8\uC5D0 \uBD88\uC774 \uBD99\uC5B4
      \uCCB4\uB825\uC774 \uACC4\uC18D \uB2F3\uC2B5\uB2C8\uB2E4.\n\uAD6C\uB974\uBA74
      \uAEBC\uC9C0\uACE0, \uAC00\uB9CC\uD788 \uC788\uC5B4\uB3C4 \uC2DC\uAC04\uC774
      \uC9C0\uB098\uBA74 \uAEBC\uC9D1\uB2C8\uB2E4. \uAC00\uB4DC\uB85C \uB9C9\uC73C\uBA74
      \uBD88\uC774 \uBD99\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uCCB4\uB825\uC774 \uC808\uBC18
      \uC544\uB798\uB85C \uB5A8\uC5B4\uC9C0\uBA74 \uD3EC\uD6A8\uD558\uACE0, \uADF8
      \uB4A4\uB85C\uB294 \uC55E\uBC1C\uACFC \uBB3C\uAE30\uC5D0\uB3C4 \uBD88\uC774
      \uBD99\uC2B5\uB2C8\uB2E4.\n\n<color=#F9C775>\uD558\uB298</color>\n\uB0A0\uC544\uC62C\uB77C
      \uBD88\uB369\uC774\uB97C \uC3D8\uAC70\uB098 \uBC14\uB2E5\uC5D0 \uBD88\uC744
      \uBFCC\uB9BD\uB2C8\uB2E4. \uBD88\uBC14\uB2E4 \uC548\uC5D0\uC11C\uB294 \uAD74\uB7EC\uB3C4
      \uAEBC\uC9C0\uC9C0 \uC54A\uC73C\uB2C8 \uBA3C\uC800 \uBE60\uC838\uB098\uC624\uC138\uC694.\n\uB0B4\uB824\uC549\uC744
      \uB54C \uB36E\uCE69\uB2C8\uB2E4. \uAC00\uB4DC\uD560 \uC218 \uC5C6\uC73C\uB2C8
      \uAD74\uB7EC\uC11C \uD53C\uD558\uC138\uC694.\n\uC591\uCABD \uB0A0\uAC1C\uB97C
      \uBAA8\uB450 \uAE68\uBA74 \uB354 \uC774\uC0C1 \uB0A0\uC9C0 \uBABB\uD569\uB2C8\uB2E4.\n\n\uBD88
      \uC800\uD56D(\uD654\uB8E1 \uBE44\uB298 \uC138\uD2B8, \uD654\uB8E1 \uC2EC\uC7A5
      \uCC1C)\uC73C\uB85C \uB300\uBE44\uD558\uC138\uC694."
  window: {fileID: 6693915415538356632}
  hintText: {fileID: 8564883923433620736}
  noticeText: {fileID: 6136519114371390999}
